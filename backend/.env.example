MONGO_URL=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
DB_NAME=
APP_ENV=development
JWT_SECRET=
CORS_ORIGINS=https://distrologistics.ge,https://www.distrologistics.ge
APP_BASE_URL=https://distrologistics.ge
