# Production-only security settings; inject secret values from your secret manager.
MONGO_TLS=true
MONGO_AUDIT_URL=
AUDIT_DB_NAME=distro_audit
FIELD_ENCRYPTION_KEY=
WEBHOOK_ALLOWED_IPS=
BANK_WEBHOOK_SECRET=
INVOICE_WEBHOOK_SECRET=
